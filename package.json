{
  "name": "pagefold",
  "version": "1.1.0",
  "private": true,
  "description": "Save any article and read it offline. No account, no sync, no network.",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.4.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
